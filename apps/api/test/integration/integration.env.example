# Exemplo de ambiente dos testes de integração (R3.2.1). NÃO coloque a senha real aqui.
#
# Copie para apps/api/.env.integration (ignorado pelo Git) e substitua o
# marcador de senha. Se a senha tiver caracteres especiais (@ : / # ? %),
# use a codificação percentual (ex.: @ vira %40).
#
# Só este formato é aceito: host 127.0.0.1, porta 5432, banco rhconnect_it,
# usuário rhconnect_it_user. Qualquer outra coisa é recusada pela guarda.
INTEGRATION_DATABASE_URL="postgresql://rhconnect_it_user:SENHA_DEFINIDA_NA_CRIACAO_DO_USUARIO@127.0.0.1:5432/rhconnect_it?schema=public&connection_limit=10"
