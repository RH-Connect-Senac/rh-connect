# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL=""

# Segredo usado para assinar e validar os tokens JWT (access token).
# Gere um valor aleatório, nunca reutilize o de outro ambiente.
JWT_SECRET=""

# URL do front-end, usada para liberar o CORS.
FRONTEND_URL="http://localhost:5173"

# Porta em que a API do NestJS vai escutar.
PORT=3000

# URL interna do serviço Python de entrevista por IA.
INTERVIEW_AI_SERVICE_URL="http://127.0.0.1:5001"

# Timeout das chamadas da API NestJS para o serviço Python, em milissegundos.
INTERVIEW_AI_TIMEOUT_MS=20000

# Timeout proprio da AVALIACAO por IA (POST /evaluate), em ms. Opcional: vazio = usa
# INTERVIEW_AI_TIMEOUT_MS. NAO ha valor recomendado ainda: so defina apos medir a latencia
# real da avaliacao (ver docs/back-end/timeout-avaliacao-ia.md). Inteiro entre 1 e 2147483647.
# Nao afeta perguntas nem extracao de vaga. Estourar o prazo nao interrompe o Python.
INTERVIEW_AI_EVALUATION_TIMEOUT_MS=

# Timeout proprio da extracao de vaga (POST /interviews/ai/job-context), em ms. Deve ser
# MAIOR que o orcamento do extrator Python (15 s, http_segura.py). Nao afeta perguntas/avaliacao.
INTERVIEW_AI_JOB_CONTEXT_TIMEOUT_MS=20000

# "development" | "production" | "test"
# Controla se o cookie de sessão exige HTTPS (secure: true em produção).
NODE_ENV="development"

# Senha inicial das contas oficiais (Admin, Carlos, Eduardo e Camila) criadas pelo seed
# (`pnpm exec prisma db seed`). OBRIGATÓRIA: o seed falha se ela não estiver definida.
# Usada apenas na criação das contas; não sobrescreve senha de contas existentes.
# Defina o valor real somente no seu .env local, nunca neste arquivo.
SEED_ACCOUNTS_PASSWORD=""
