generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model account_activation_token {
  activation_token_id String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             Int
  token_hash          String        @unique @db.VarChar(255)
  token_purpose       token_purpose @default(EVALUATOR_INVITE)
  expires_at          DateTime      @db.Timestamptz(6)
  used_at             DateTime?     @db.Timestamptz(6)
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  app_user            app_user      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_account_activation_token_user")

  @@index([expires_at], map: "idx_activation_token_expires_at")
  @@index([token_hash], map: "idx_activation_token_hash")
  @@index([used_at], map: "idx_activation_token_used_at")
  @@index([user_id], map: "idx_activation_token_user_id")
}

model app_user {
  user_id                  Int                        @id @default(autoincrement())
  name                     String                     @db.VarChar(150)
  email                    String                     @unique @db.VarChar(255)
  password_hash            String?                    @db.VarChar(255)
  user_role                user_role
  account_status           account_status             @default(ACTIVE)
  onboarding_completed_at  DateTime?                  @db.Timestamptz(6)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  account_activation_token account_activation_token[]
  candidate_profile        candidate_profile?
  evaluator_profile        evaluator_profile?
  interview_as_candidate   interview[]                @relation("interview_candidate")
  interview_assigned       interview[]                @relation("interview_assigned_by")
  session                  session[]
  terms_acceptance         terms_acceptance[]

  @@index([email], map: "idx_app_user_email")
  @@index([user_role], map: "idx_app_user_role")
  @@index([account_status], map: "idx_app_user_status")
}

model candidate_profile {
  candidate_profile_id              Int                    @id @default(autoincrement())
  user_id                           Int                    @unique
  professional_title                String?                @db.VarChar(60)
  desired_position                  String?                @db.VarChar(60)
  professional_area                 String?                @db.VarChar(50)
  professional_subarea              String?                @db.VarChar(50)
  professional_level                professional_level?
  contract_type                     contract_type?
  professional_summary              String?                @db.VarChar(600)
  city                              String?                @db.VarChar(100)
  state                             String?                @db.Char(2)
  courses_none_declared_at          DateTime?              @db.Timestamptz(6)
  experience_none_declared_at       DateTime?              @db.Timestamptz(6)
  technical_skills_none_declared_at DateTime?              @db.Timestamptz(6)
  created_at                        DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime               @default(now()) @db.Timestamptz(6)
  app_user                          app_user               @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_candidate_profile_user")
  candidate_education               candidate_education[]
  candidate_course                  candidate_course[]
  candidate_experience              candidate_experience[]
  candidate_skill                   candidate_skill[]

  @@index([user_id], map: "idx_candidate_profile_user_id")
}

model candidate_education {
  education_id          Int               @id @default(autoincrement())
  candidate_profile_id  Int
  degree                String?           @db.VarChar(80)
  education_institution String            @db.VarChar(80)
  academic_level        academic_level
  education_status      education_status
  start_date            DateTime          @db.Date
  end_date              DateTime?         @db.Date
  created_at            DateTime          @default(now()) @db.Timestamptz(6)
  updated_at            DateTime          @default(now()) @db.Timestamptz(6)
  candidate_profile     candidate_profile @relation(fields: [candidate_profile_id], references: [candidate_profile_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_candidate_education_profile")

  @@index([candidate_profile_id], map: "idx_candidate_education_profile_id")
}

model candidate_course {
  course_id            Int               @id @default(autoincrement())
  candidate_profile_id Int
  course_name          String            @db.VarChar(80)
  course_institution   String?           @db.VarChar(80)
  workload_hours       Int?
  course_status        course_status
  start_date           DateTime?         @db.Date
  completed_at         DateTime?         @db.Date
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  updated_at           DateTime          @default(now()) @db.Timestamptz(6)
  candidate_profile    candidate_profile @relation(fields: [candidate_profile_id], references: [candidate_profile_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_candidate_course_profile")

  @@index([candidate_profile_id], map: "idx_candidate_course_profile_id")
}

model candidate_experience {
  experience_id        Int               @id @default(autoincrement())
  candidate_profile_id Int
  company_name         String            @db.VarChar(80)
  job_role             String            @db.VarChar(60)
  start_date           DateTime          @db.Date
  end_date             DateTime?         @db.Date
  is_current           Boolean           @default(false)
  description          String?           @db.VarChar(800)
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  updated_at           DateTime          @default(now()) @db.Timestamptz(6)
  candidate_profile    candidate_profile @relation(fields: [candidate_profile_id], references: [candidate_profile_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_candidate_experience_profile")

  @@index([candidate_profile_id], map: "idx_candidate_experience_profile_id")
}

// A unicidade case-insensitive (candidate_profile_id, skill_type, lower(skill_name))
// vive em um índice funcional criado na migration (o Prisma não o expressa).
model candidate_skill {
  skill_id             Int               @id @default(autoincrement())
  candidate_profile_id Int
  skill_type           skill_type
  skill_name           String            @db.VarChar(60)
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  candidate_profile    candidate_profile @relation(fields: [candidate_profile_id], references: [candidate_profile_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_candidate_skill_profile")

  @@index([candidate_profile_id, skill_type], map: "idx_candidate_skill_profile_type")
}

model evaluator_profile {
  evaluator_profile_id Int                           @id @default(autoincrement())
  user_id              Int                           @unique
  area                 String?                       @db.VarChar(100)
  specialization       String?                       @db.VarChar(150)
  availability_status  evaluator_availability_status @default(AVAILABLE)
  created_at           DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                      @default(now()) @db.Timestamptz(6)
  app_user             app_user                      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_evaluator_profile_user")
  interview            interview[]

  @@index([user_id], map: "idx_evaluator_profile_user_id")
}

model external_learning_resource {
  resource_id           String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source                String                            @db.VarChar(50)
  external_key          String                            @unique @db.VarChar(128)
  title                 String                            @db.VarChar(200)
  resource_type         String                            @db.VarChar(50)
  section               String?                           @db.VarChar(200)
  area                  String?                           @db.VarChar(120)
  url                   String?                           @db.Text
  cover_url             String?                           @db.Text
  direct_link_available Boolean                           @default(false)
  is_active             Boolean                           @default(true)
  created_at            DateTime                          @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                          @default(now()) @db.Timestamptz(6)
  category_links        external_resource_category_link[]

  @@index([source], map: "idx_external_learning_resource_source")
  @@index([area], map: "idx_external_learning_resource_area")
  @@index([resource_type], map: "idx_external_learning_resource_type")
  @@index([is_active], map: "idx_external_learning_resource_active")
}

model external_resource_category {
  category_id   String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source        String                            @db.VarChar(50)
  external_code String                            @db.VarChar(50)
  name          String                            @db.VarChar(150)
  slug          String                            @db.VarChar(150)
  created_at    DateTime                          @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                          @default(now()) @db.Timestamptz(6)
  links         external_resource_category_link[]

  @@unique([source, external_code])
  @@unique([source, slug])
  @@index([source], map: "idx_external_resource_category_source")
}

model external_resource_category_link {
  link_id     String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource_id String                     @db.Uuid
  category_id String                     @db.Uuid
  created_at  DateTime                   @default(now()) @db.Timestamptz(6)
  resource    external_learning_resource @relation(fields: [resource_id], references: [resource_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_external_resource_category_link_resource")
  category    external_resource_category @relation(fields: [category_id], references: [category_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_external_resource_category_link_category")

  @@unique([resource_id, category_id])
  @@index([resource_id], map: "idx_external_resource_category_link_resource_id")
  @@index([category_id], map: "idx_external_resource_category_link_category_id")
}

// Entrevista real e persistente. O contexto da vaga é um SNAPSHOT (a URL externa
// pode mudar ou sumir). O avaliador humano é evaluator_profile_id (única fonte:
// interview_evaluation não repete o avaliador). Regras de coerência entre
// status, evaluation_mode, evaluator_profile_id e submitted_at vivem em CHECKs
// criados na migration (o Prisma não os expressa). updated_at é preenchido pelo
// service, como nos demais models do projeto.
model interview {
  interview_id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_user_id    Int
  evaluation_mode      evaluation_mode?
  status               interview_status      @default(IN_PROGRESS)
  job_title            String                @db.VarChar(80)
  job_company          String?               @db.VarChar(80)
  job_summary          String?               @db.VarChar(800)
  job_activities       Json                  @default("[]") @db.JsonB
  job_requirements     Json                  @default("[]") @db.JsonB
  job_location         String?               @db.VarChar(60)
  job_contract_type    String?               @db.VarChar(40)
  job_work_mode        job_work_mode?
  job_source_url       String                @db.Text
  evaluator_profile_id Int?
  assigned_at          DateTime?             @db.Timestamptz(6)
  assigned_by_user_id  Int?
  submitted_at         DateTime?             @db.Timestamptz(6)
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime              @default(now()) @db.Timestamptz(6)
  candidate            app_user              @relation("interview_candidate", fields: [candidate_user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_interview_candidate_user")
  evaluator_profile    evaluator_profile?    @relation(fields: [evaluator_profile_id], references: [evaluator_profile_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_interview_evaluator_profile")
  assigned_by          app_user?             @relation("interview_assigned_by", fields: [assigned_by_user_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_interview_assigned_by_user")
  questions            interview_question[]
  evaluation           interview_evaluation?

  @@index([candidate_user_id, created_at], map: "idx_interview_candidate_created_at")
  @@index([status, submitted_at], map: "idx_interview_status_submitted_at")
  @@index([evaluator_profile_id, status], map: "idx_interview_evaluator_status")
}

// Pergunta + resposta na mesma linha (relação 1:1, mesmo ciclo de vida). A
// quantidade de perguntas NÃO é restrição do banco; só position >= 1 (CHECK na
// migration) e unicidade da posição dentro da entrevista.
model interview_question {
  question_id   String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interview_id  String                          @db.Uuid
  position      Int                             @db.SmallInt
  question_type interview_question_type
  question_text String                          @db.VarChar(500)
  answer_text   String?                         @db.VarChar(1000)
  answered_at   DateTime?                       @db.Timestamptz(6)
  // RASCUNHO em andamento (autosave do candidato). NUNCA conta como resposta:
  // o submit e a avaliação olham só answer_text. draft_version é o contador
  // otimista entre dispositivos (incrementa a cada gravação/confirmação).
  draft_text       String?                      @db.VarChar(1000)
  draft_updated_at DateTime?                    @db.Timestamptz(6)
  draft_version    Int                          @default(0)
  created_at    DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                        @default(now()) @db.Timestamptz(6)
  interview     interview                       @relation(fields: [interview_id], references: [interview_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_interview_question_interview")
  evaluations   interview_question_evaluation[]

  @@unique([interview_id, position])
  // Alvo da FK composta de interview_question_evaluation (mesma entrevista).
  @@unique([question_id, interview_id])
}

// No máximo UMA avaliação por entrevista (AI ou HUMAN, conforme
// interview.evaluation_mode). Sem evaluator_profile_id: o avaliador humano é
// interview.evaluator_profile_id.
model interview_evaluation {
  evaluation_id        String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interview_id         String                          @unique @db.Uuid
  status               evaluation_status               @default(DRAFT)
  criteria_scores      Json                            @default("{}") @db.JsonB
  overall_score        Decimal?                        @db.Decimal(3, 1)
  summary              String?                         @db.Text
  strengths            Json?                           @db.JsonB
  improvements         Json?                           @db.JsonB
  recommendations      Json?                           @db.JsonB
  completed_at         DateTime?                       @db.Timestamptz(6)
  created_at           DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                        @default(now()) @db.Timestamptz(6)
  interview            interview                       @relation(fields: [interview_id], references: [interview_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_interview_evaluation_interview")
  question_evaluations interview_question_evaluation[]

  // Alvo da FK composta de interview_question_evaluation (mesma entrevista).
  @@unique([evaluation_id, interview_id])
}

// interview_id é cópia intencional: as duas FKs compostas (evaluation_id,
// interview_id) e (question_id, interview_id) garantem que avaliação e pergunta
// pertencem à MESMA entrevista (FKs simples não garantiriam).
model interview_question_evaluation {
  question_evaluation_id String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evaluation_id          String               @db.Uuid
  question_id            String               @db.Uuid
  interview_id           String               @db.Uuid
  score                  Decimal              @db.Decimal(3, 1)
  reason                 String               @db.Text
  positives              Json                 @default("[]") @db.JsonB
  improvements           Json                 @default("[]") @db.JsonB
  suggestion             String               @db.Text
  evaluation             interview_evaluation @relation(fields: [evaluation_id, interview_id], references: [evaluation_id, interview_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_interview_question_evaluation_evaluation")
  question               interview_question   @relation(fields: [question_id, interview_id], references: [question_id, interview_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_interview_question_evaluation_question")

  @@unique([evaluation_id, question_id])
}

model session {
  session_id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            Int
  refresh_token_hash String    @db.VarChar(255)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  expires_at         DateTime  @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  app_user           app_user  @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_session_user")

  @@index([expires_at], map: "idx_session_expires_at")
  @@index([revoked_at], map: "idx_session_revoked_at")
  @@index([user_id], map: "idx_session_user_id")
}

model terms_acceptance {
  acceptance_id    Int           @id @default(autoincrement())
  user_id          Int
  document_type    document_type
  document_version String        @db.VarChar(20)
  accepted_at      DateTime      @default(now()) @db.Timestamptz(6)
  app_user         app_user      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_terms_acceptance_user")

  @@index([user_id], map: "idx_terms_user_id")
}

model tester_feedback {
  feedback_id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feature                String   @db.VarChar(150)
  bug_found              String?  @db.Text
  steps_to_reproduce     String?  @db.Text
  improvement_suggestion String?  @db.Text
  created_at             DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_tester_feedback_created_at")
}

enum academic_level {
  ENSINO_FUNDAMENTAL
  ENSINO_MEDIO
  TECNICO
  TECNOLOGO
  GRADUACAO
  POS_GRADUACAO
  MESTRADO
  DOUTORADO
}

enum contract_type {
  CLT
  ESTAGIO
  PJ
  TEMPORARIO
}

enum course_status {
  EM_ANDAMENTO
  CONCLUIDO
}

enum education_status {
  EM_ANDAMENTO
  CONCLUIDO
  TRANCADO
  INTERROMPIDO
}

enum professional_level {
  TRAINEE
  JUNIOR
  PLENO
  SENIOR
}

enum skill_type {
  TECHNICAL
  BEHAVIORAL
}

enum account_status {
  PENDING_VERIFICATION
  INVITED
  ACTIVE
  BLOCKED
  INACTIVE
}

enum document_type {
  TERMS_OF_USE
  PRIVACY_POLICY
}

enum evaluator_availability_status {
  AVAILABLE
  UNAVAILABLE
  INACTIVE
}

enum token_purpose {
  EVALUATOR_INVITE
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum user_role {
  CANDIDATE
  EVALUATOR
  ADMIN
}

enum evaluation_mode {
  AI
  HUMAN
}

enum interview_status {
  IN_PROGRESS
  PENDING_AI_EVALUATION
  PENDING_ASSIGNMENT
  ASSIGNED
  COMPLETED
  // Encerrada pelo candidato antes do envio (POST /interviews/:id/cancel). Não é
  // uma entrevista enviada: sem submitted_at e fora do fluxo de avaliação.
  CANCELLED
}

enum evaluation_status {
  DRAFT
  COMPLETED
}

enum interview_question_type {
  TECHNICAL
  BEHAVIORAL
  CAREER
}

enum job_work_mode {
  REMOTE
  HYBRID
  ONSITE
}
