generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model account_activation_token {
  activation_token_id String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             Int
  token_hash          String        @db.VarChar(255)
  token_purpose       token_purpose @default(EVALUATOR_INVITE)
  expires_at          DateTime      @db.Timestamptz(6)
  used_at             DateTime?     @db.Timestamptz(6)
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  app_user            app_user      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_account_activation_token_user")

  @@index([expires_at], map: "idx_activation_token_expires_at")
  @@index([token_hash], map: "idx_activation_token_hash")
  @@index([used_at], map: "idx_activation_token_used_at")
  @@index([user_id], map: "idx_activation_token_user_id")
}

model app_user {
  user_id                  Int                        @id @default(autoincrement())
  name                     String                     @db.VarChar(150)
  email                    String                     @unique @db.VarChar(255)
  password_hash            String?                    @db.VarChar(255)
  user_role                user_role
  account_status           account_status             @default(ACTIVE)
  onboarding_completed_at  DateTime?                  @db.Timestamptz(6)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  account_activation_token account_activation_token[]
  candidate_profile        candidate_profile?
  evaluator_profile        evaluator_profile?
  session                  session[]
  terms_acceptance         terms_acceptance[]

  @@index([email], map: "idx_app_user_email")
  @@index([user_role], map: "idx_app_user_role")
  @@index([account_status], map: "idx_app_user_status")
}

model candidate_profile {
  candidate_profile_id Int      @id @default(autoincrement())
  user_id              Int      @unique
  professional_title   String?  @db.VarChar(120)
  city                 String?  @db.VarChar(100)
  state                String?  @db.Char(2)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @db.Timestamptz(6)
  app_user             app_user @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_candidate_profile_user")

  @@index([user_id], map: "idx_candidate_profile_user_id")
}

model evaluator_profile {
  evaluator_profile_id Int                           @id @default(autoincrement())
  user_id              Int                           @unique
  area                 String?                       @db.VarChar(100)
  specialization       String?                       @db.VarChar(150)
  availability_status  evaluator_availability_status @default(AVAILABLE)
  created_at           DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                      @default(now()) @db.Timestamptz(6)
  app_user             app_user                      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_evaluator_profile_user")

  @@index([user_id], map: "idx_evaluator_profile_user_id")
}

model session {
  session_id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            Int
  refresh_token_hash String    @db.VarChar(255)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  expires_at         DateTime  @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  app_user           app_user  @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_session_user")

  @@index([expires_at], map: "idx_session_expires_at")
  @@index([revoked_at], map: "idx_session_revoked_at")
  @@index([user_id], map: "idx_session_user_id")
}

model terms_acceptance {
  acceptance_id    Int           @id @default(autoincrement())
  user_id          Int
  document_type    document_type
  document_version String        @db.VarChar(20)
  accepted_at      DateTime      @default(now()) @db.Timestamptz(6)
  app_user         app_user      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_terms_acceptance_user")

  @@index([user_id], map: "idx_terms_user_id")
}

enum account_status {
  PENDING_VERIFICATION
  INVITED
  ACTIVE
  BLOCKED
  INACTIVE
}

enum document_type {
  TERMS_OF_USE
  PRIVACY_POLICY
}

enum evaluator_availability_status {
  AVAILABLE
  UNAVAILABLE
  INACTIVE
}

enum token_purpose {
  EVALUATOR_INVITE
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum user_role {
  CANDIDATE
  EVALUATOR
  ADMIN
}
