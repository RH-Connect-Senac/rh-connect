{
  "name": "rh-connect",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev:web": "cd apps/web && pnpm run dev",
    "build:web": "cd apps/web && pnpm run build",
    "format:web": "cd apps/web && pnpm run format",
    "format:check:web": "cd apps/web && pnpm run format:check",
    "lint:web": "cd apps/web && pnpm run lint",
    "test:web": "cd apps/web && pnpm run test:run",
    "typecheck:web": "cd apps/web && pnpm run typecheck",
    "dev:api": "cd apps/api && npm run start:dev",
    "start:prod": "cd apps/api && npm run start:prod",
    "build:api": "cd apps/api && npm run build",
    "lint:api": "cd apps/api && npm run lint",
    "test:api": "cd apps/api && npm run test",
    "test:api:e2e": "cd apps/api && npm run test:e2e",
    "db:up": "cd apps/api && docker compose up -d",
    "db:migrate": "cd apps/api && npx prisma migrate deploy",
    "db:seed": "cd apps/api && npx prisma db seed"
  }
}