# Groq - configuracao com multiplas API keys
#
# GROQ_API_KEYS aceita uma ou mais keys separadas por virgula. Espacos ao
# redor de cada valor sao removidos e entradas vazias sao descartadas -
# a quantidade de keys e livre (nao ha limite fixo no codigo).
#
# Use SOMENTE credenciais DISTINTAS entre si. O parser preserva duplicatas
# (por compatibilidade com o comportamento ja implementado), mas duplicar a
# mesma key nao traz nenhum beneficio de fallback e nao e recomendado:
#
#   NAO recomendado:  GROQ_API_KEYS=<GROQ_KEY_01>,<GROQ_KEY_01>,<GROQ_KEY_02>
#   Recomendado:      GROQ_API_KEYS=<GROQ_KEY_01>,<GROQ_KEY_02>,<GROQ_KEY_03>
#
# Exemplo de formato. Mantenha apenas placeholders neste arquivo. Configure
# os segredos reais no `.env` local ou diretamente no ambiente da VPS:
# GROQ_API_KEYS=<GROQ_KEY_01>,<GROQ_KEY_02>,<GROQ_KEY_03>
GROQ_API_KEYS=

# Groq - compatibilidade com uma unica API key
#
# GROQ_API_KEY continua sendo aceita como fallback de compatibilidade,
# usada SOMENTE quando GROQ_API_KEYS estiver ausente, vazia, ou nao
# resultar em nenhuma key valida apos o parsing.
#
# Se as duas variaveis estiverem definidas ao mesmo tempo, GROQ_API_KEYS
# tem precedencia TOTAL - GROQ_API_KEY e ignorada nesse caso (as duas
# configuracoes nunca sao concatenadas/somadas).
#
# Exemplo (ambiente com uma unica credencial, sem fallback entre keys):
# GROQ_API_KEY=<GROQ_KEY>
GROQ_API_KEY=

GROQ_MODEL=
PORT=5001
REQUEST_TIMEOUT_SECONDS=20
